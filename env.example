# Salin file ini jadi ".env" lalu isi dengan nilai asli dari dashboard Meta for Developers

# Token bebas kamu tentukan sendiri, nanti dimasukkan juga ke kolom "Verify Token" di dashboard Meta
WA_VERIFY_TOKEN=minci-verify-token-rahasia

# Access token dari Meta App (WhatsApp > API Setup). Untuk testing pakai "Temporary access token".
# Untuk produksi, buat System User + Permanent Token.
WA_ACCESS_TOKEN=isi_access_token_disini

# Phone Number ID dari Meta App (WhatsApp > API Setup)
WA_PHONE_NUMBER_ID=isi_phone_number_id_disini

# Versi Graph API (biasanya tidak perlu diubah)
WA_API_VERSION=v20.0
